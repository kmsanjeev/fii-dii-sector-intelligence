    "ApprovalStatus": {
      "enum": [
        "PENDING",
        "UNDER_REVIEW",
        "APPROVED",
        "APPROVED_WITH_CONDITIONS",
        "REJECTED",
        "NEEDS_MORE_RESEARCH",
        "MERGE_REQUIRED",
        "SUPERSEDE_APPROVED",
        "ARCHIVED"
      ],
      "title": "ApprovalStatus",
      "type": "string"
    },
    "PromotionState": {

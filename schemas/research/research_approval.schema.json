    "action": {
      "$ref": "#/$defs/AdminAction"
    },
    "status": {
      "$ref": "#/$defs/ApprovalStatus"
    },
    "decided_by": {
      "title": "Decided By",
      "type": "string"
    },
    "decided_at": {
      "title": "Decided At",
      "type": "string"
    },
    "reason": {
      "title": "Reason",
      "type": "string"
    },
    "conditions": {
      "items": {
        "type": "string"

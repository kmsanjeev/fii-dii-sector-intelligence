    },
    "domains": {
      "items": {
        "type": "string"
      },
      "title": "Domains",
      "type": "array"
    },
    "quality_grade": {
      "$ref": "#/$defs/QualityGrade",
      "default": "U"
    },
    "authority_score": {
      "anyOf": [
        {
          "maximum": 100,
          "minimum": 0,

    },
    "title_normalized": {
      "title": "Title Normalized",
      "type": "string"
    },
    "source_class": {
      "$ref": "#/$defs/SourceClass"
    },
    "author_attributed": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,

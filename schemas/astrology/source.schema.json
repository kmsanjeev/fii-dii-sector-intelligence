      "default": null,
      "title": "Authority Score"
    },
    "authority_profile": {
      "$ref": "#/$defs/AuthorityProfile"
    },
    "verification_status": {
      "$ref": "#/$defs/VerificationStatus",
      "default": "UNKNOWN"
    },
    "evidence_type": {
      "$ref": "#/$defs/EvidenceType",
      "default": "CLASSICAL_TEXTUAL"
    }
  },
  "required": [
    "created_at",
    "created_by",
    "updated_at",
    "updated_by",
    "change_reason",
    "source_id",
    "title_normalized",
    "source_class",
    "authority_profile"

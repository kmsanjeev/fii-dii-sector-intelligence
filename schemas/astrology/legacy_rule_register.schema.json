    },
    "updated_at": {
      "title": "Updated At",
      "type": "string"
    },
    "updated_by": {
      "title": "Updated By",
      "type": "string"
    },
    "change_reason": {
      "title": "Change Reason",
      "type": "string"
    },
    "supersedes": {

# Local runtime policy
VEDA_RUNTIME_ENV=local
VEDA_AUTH_ENABLED=false

# First admin bootstrap
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional broker-credential encryption secret
VEDA_BROKER_CREDENTIAL_SECRET=

# Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LLM providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
GITHUB_MODELS_TOKEN=
SAMBANOVA_API_KEY=
TOGETHER_API_KEY=

# Autonomous research runtime (P009)
VEDA_RESEARCH_RUNTIME_ENABLED=
VEDA_RESEARCH_SCHEDULER_TIMEZONE=
VEDA_RESEARCH_SCHEDULER_POLL_SECONDS=
VEDA_RESEARCH_WORKER_LEASE_SECONDS=

# External research providers (P009)
VEDA_RESEARCH_EXTERNAL_ENABLED=
VEDA_RESEARCH_EXTERNAL_SEARCH_ENABLED=
VEDA_RESEARCH_EXTERNAL_RETRIEVAL_ENABLED=
VEDA_RESEARCH_FETCH_TIMEOUT_S=
VEDA_RESEARCH_FETCH_MAX_BYTES=
VEDA_RESEARCH_FETCH_MAX_TEXT_CHARS=
VEDA_RESEARCH_FETCH_MAX_REDIRECTS=
